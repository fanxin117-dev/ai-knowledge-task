# 本地 PostgreSQL 连接串。
# 格式为：postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL="postgresql://fxyan:qwe123@localhost:5432/knowledge?schema=public"

# AI_PROVIDER 默认使用 mock，保证本地开发和测试不依赖外部网络或密钥。
# 如需使用真实 OpenAI Responses API，请改为 openai，并填写密钥与模型名。
# 页面级手动配置在 /settings/ai，优先用于单次 AI 请求。
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2"
